# Copy this to api/.env and fill in the key. Everything here is read by the
# server and by every tool in tools/, so nothing has to be typed on a command
# line -- which matters because that incantation is different in bash and in
# powershell, and getting it wrong is how a database ends up seeded with no key
# and personal data written in the clear.
#
# api/.env is gitignored. It never leaves the machine it is on.

# Local postgres. Create it once with:
#   sudo -u postgres psql -c "CREATE ROLE sp LOGIN PASSWORD 'sp' SUPERUSER"
#   sudo -u postgres createdb -O sp sp
DATABASE_URL=postgres://sp:sp@127.0.0.1:5432/sp

# 32 bytes, base64. Make a fresh one for this machine:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# A local key has nothing to do with the one on Railway and does not need to
# match it. It only has to match itself: change it and the accounts already in
# this database stop decrypting.
SUBMISSIONS_KEY=

# The dashboard. Staging turns this on by itself; locally it does not, and
# without it /dashboard is a plain 404 that looks like something is broken.
DASHBOARD_NEXT=true

PORT=3999
